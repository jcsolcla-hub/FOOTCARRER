{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "A real player review stored in Firestore",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user who authored the review",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Name or display name of the user",
          "maxLength": 100
        },
        "nombre": {
          "type": "string",
          "description": "Fallback name field of the user",
          "maxLength": 100
        },
        "rating": {
          "type": "number",
          "description": "Rating score between 1 and 5"
        },
        "comment": {
          "type": "string",
          "description": "Text content of the review",
          "maxLength": 1000
        },
        "comentario": {
          "type": "string",
          "description": "Fallback comment field of the review",
          "maxLength": 1000
        },
        "authorPhoto": {
          "type": "string",
          "description": "Photo URL of the author if authenticated with Google",
          "maxLength": 1000
        },
        "isGoogleUser": {
          "type": "boolean",
          "description": "Flag indicating if user is signed in with Google"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the review was created"
        }
      },
      "required": ["userId", "rating", "comment", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile metadata for player authentication",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "nombre": {
          "type": "string",
          "description": "User display name",
          "maxLength": 120
        },
        "fotoPerfil": {
          "type": "string",
          "description": "Profile picture URL",
          "maxLength": 1000
        },
        "metodoAuth": {
          "type": "string",
          "description": "Authentication provider method",
          "maxLength": 64
        },
        "ultimoAcceso": {
          "type": "string",
          "format": "date-time",
          "description": "Last access timestamp"
        },
        "fechaCreacion": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        }
      },
      "required": ["uid"]
    },
    "CareerSave": {
      "title": "CareerSave",
      "description": "Player game progress and career save state",
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Serialized career state object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated server timestamp"
        }
      },
      "required": ["data", "updatedAt"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Shared real reviews collection from all users"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile documents"
    },
    "/users/{userId}/career/{careerId}": {
      "schema": "CareerSave",
      "description": "Private game save data for each user"
    }
  }
}
